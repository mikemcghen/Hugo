+            else:
+                inferred["possibilities"] = ["Phase 4.1", "Phase 4.2", "Phase 5"]
+                inferred["suggested_disambiguation"] = "Which phase — 4.1, 4.2, or 5?"
+
+        elif detected_pattern == "patch":
